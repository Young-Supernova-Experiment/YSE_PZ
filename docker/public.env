VOL= ../
VOL_DB=../database/
DB_PWD=password
STATIC_VOL=../YSE_PZ/static/
LOCAL_DB_PORT=53306
LOCAL_HTTP_PORT=8080
DJANGO_SUPERUSER_PASSWORD=password123
DJANGO_SUPERUSER_USERNAME=admin123
DJANGO_SUPERUSER_EMAIL=test@gamil.com
VOL_GHOST=../ghost_logs/
# Optional: enable shared cache (start redis: docker compose up -d yse_redis).
# Redis refuses to start without a password: set your own REDIS_PASSWORD here
# (letters and digits only, so it can sit in the URL unescaped), then REDIS_URL.
# REDIS_PASSWORD=<choose a password>
# REDIS_URL=redis://:<same password>@yse_redis:6379/0
# Local development runs with DEBUG on (overrides IS_DEBUG in YSE_PZ/settings.ini).
YSE_IS_DEBUG=1
